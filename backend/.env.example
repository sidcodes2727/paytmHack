# VAADA backend configuration. Leave a value empty to keep the offline fallback.
# Restart uvicorn after editing.

# --- Sarvam AI (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=

# Optional Sarvam overrides
SARVAM_BASE_URL=
# default: sarvam-105b
SARVAM_CHAT_MODEL=
# Only needed for live screenshot OCR (take the URL from your Sarvam account docs)
SARVAM_OCR_URL=

# --- Signing keys (optional; random per start if empty) ---
VAADA_SECRET=
VAADA_BANK_KEY=
